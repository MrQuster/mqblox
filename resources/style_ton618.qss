* { outline: none; font-style: normal; }
QMainWindow, QDialog, QInputDialog, QMessageBox, QFileDialog {
    background-color: #0B0F19;
    color: #F8FAFC;
}
QToolTip {
    background-color: #111827;
    color: #F9FAFB;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}
QScrollArea, QWidget#ScrollContents { background: transparent; border: none; }
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 4px 1px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.35);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QFrame#Sidebar, QFrame#GlassCard, QFrame#AuthorsBox, QFrame#WarningBanner {
    background: transparent;
    border: none;
}
QLabel {
    color: #F8FAFC;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', sans-serif;
    font-size: 13px;
    background: transparent;
}
QLabel#LogoText { font-size: 18px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.3px; }
QLabel#SectionTitle { font-size: 14px; font-weight: 700; color: #F3F4F6; }
QLabel#SubText { font-size: 11px; color: #9CA3AF; }

QLabel#RobuxCardBadge {
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 5px 12px;
    font-size: 13px;
    font-weight: 700;
}
QLabel#ToastBanner {
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#AutoSyncBadge, QLabel#StatusBadge {
    color: #F3F4F6;
    background: transparent;
    border: none;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}
QProgressBar#RamBar, QProgressBar#UpdateBar {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    height: 18px;
}
QSpinBox, QLineEdit {
    background: transparent;
    color: #FFFFFF;
    border: none;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 13px;
    min-height: 24px;
    selection-background-color: rgba(56, 189, 248, 0.35);
    selection-color: #FFFFFF;
}
QListView#ComboPopupList {
    background-color: #111827;
    color: #F9FAFB;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 4px;
    outline: none;
}
QListView#ComboPopupList::item {
    background-color: transparent;
    color: #E5E7EB;
    padding: 8px 12px;
    border-radius: 6px;
    min-height: 20px;
}
QListView#ComboPopupList::item:hover,
QListView#ComboPopupList::item:selected {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    font-weight: 600;
}
QCheckBox {
    color: #F3F4F6;
    spacing: 12px;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    min-height: 26px;
}
QCheckBox::indicator { width: 48px; height: 26px; }
QTextEdit {
    background-color: #111827;
    color: #F3F4F6;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 10px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 11px;
}
