* { outline: none; font-style: normal; }
QMainWindow, QDialog, QInputDialog, QMessageBox, QFileDialog {
    background-color: #020307;
    color: #F8FAFC;
}
QToolTip {
    background-color: rgba(10, 14, 26, 195);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 90);
    border-radius: 10px;
    padding: 6px 12px;
    font-weight: 700;
}
QScrollArea, QWidget#ScrollContents { background: transparent; border: none; }
QScrollBar:vertical {
    background: rgba(255, 255, 255, 10);
    width: 6px;
    border-radius: 3px;
    margin: 4px 1px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 95);
    border-radius: 3px;
    min-height: 34px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QFrame#Sidebar, QFrame#GlassCard, QFrame#AuthorsBox, QFrame#WarningBanner {
    background: transparent;
    border: none;
}
QLabel {
    color: #F8FAFC;
    font-family: 'Inter', 'SF Pro Display', 'Noto Sans', sans-serif;
    font-size: 13px;
    background: transparent;
}
QLabel#LogoText { font-size: 19px; font-weight: 900; color: #FFFFFF; }
QLabel#SectionTitle { font-size: 15px; font-weight: 800; color: #FFFFFF; }
QLabel#SubText { font-size: 11px; color: rgba(241, 245, 249, 215); }

QLabel#RobuxCardBadge {
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 900;
}
QLabel#ToastBanner {
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 5px 15px;
    font-size: 12px;
    font-weight: 800;
}
QLabel#AutoSyncBadge, QLabel#StatusBadge {
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 800;
}
QProgressBar#RamBar, QProgressBar#UpdateBar {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    height: 20px;
}
QSpinBox, QLineEdit {
    background: transparent;
    color: #FFFFFF;
    border: none;
    padding: 6px 12px;
    font-weight: 700;
    min-height: 24px;
    selection-background-color: rgba(255, 255, 255, 90);
    selection-color: #FFFFFF;
}
QListView#ComboPopupList {
    background-color: rgba(8, 12, 24, 155);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 85);
    border-radius: 14px;
    padding: 6px;
    outline: none;
}
QListView#ComboPopupList::item {
    background-color: transparent;
    color: #F1F5F9;
    padding: 9px 14px;
    border-radius: 9px;
    min-height: 22px;
}
QListView#ComboPopupList::item:hover,
QListView#ComboPopupList::item:selected {
    background-color: rgba(255, 255, 255, 38);
    color: #FFFFFF;
    font-weight: 800;
}
QCheckBox {
    color: #F8FAFC;
    spacing: 12px;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    min-height: 28px;
}
QCheckBox::indicator { width: 48px; height: 26px; }
QTextEdit {
    background-color: rgba(6, 10, 20, 28);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 52);
    border-radius: 14px;
    padding: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
}
